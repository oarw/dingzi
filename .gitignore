# build output
/bin/
/dist/
*.exe
*.exe~
*.test
*.out

# runtime data
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# local config (keep the examples)
config.yaml
agent.yaml
!config.example.yaml
!agent.example.yaml

# e2e run artifacts. The scripts are tracked; their output is not — the panel
# prints the generated agent secret and the one-time admin password to stdout on
# first start, so a captured log is a credentials file.
*.log
*.log.err
/e2e/data/
/e2e/dingzi-*

# WSL Linux verification: the rootfs and the cross-compiled test binaries are
# large build artifacts. run-tests.sh is tracked; everything it operates on is
# rebuilt on demand.
/e2e/wsl/*.tar.gz
/e2e/wsl/rootfs/
/e2e/wsl/*.test

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
