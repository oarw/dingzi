# build output
/bin/
/dist/
*.exe
*.exe~
*.test
*.out

# runtime data
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# local config (keep the examples)
config.yaml
agent.yaml
!config.example.yaml
!agent.example.yaml

# e2e output. Everything generated goes in one ignored directory rather than
# being enumerated file by file, because the panel prints the generated agent
# secret and the one-time admin password to stdout on first start — so anything
# that captures its output is a credentials file, and a per-file ignore list is
# one forgotten entry away from committing one. The scripts are tracked; nothing
# they produce is.
/e2e/run/
*.log
*.log.err

# WSL Linux verification: rootfs, tarball and cross-compiled binaries are large
# build artifacts, rebuilt on demand. run-tests.sh is tracked.
/e2e/wsl/*.tar.gz
/e2e/wsl/rootfs/
/e2e/wsl/*.test
/e2e/wsl/dingzi-*

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
